# CA1C System - .gitignore
# Professional exclusions for the Streamlit refactor (streamlit-refactor branch)

# Virtual environment
/venv/
venv/
.env/
env/

# Python cache & compiled
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyo

# Environment / secrets
.env
.env.local
*.env

# Database files (local runtime data; schema committed separately)
*.db
*.sqlite3
*.sqlite

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Streamlit
.streamlit/cache/
.streamlit/secrets.toml

# Logs
*.log
logs/

# Archived legacy code (pre-Streamlit desktop GUI)
# These files are preserved locally for reference but deliberately excluded from the repository
archive/

# Temporary / build artifacts
*.tmp
*.temp
*.bak
dist/
build/
